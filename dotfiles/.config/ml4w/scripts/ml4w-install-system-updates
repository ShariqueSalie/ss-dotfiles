#!/usr/bin/env bash
#    ____         __       ____               __     __
#   /  _/__  ___ / /____ _/ / / __ _____  ___/ /__ _/ /____ ___
#  _/ // _ \(_-</ __/ _ `/ / / / // / _ \/ _  / _ `/ __/ -_|_-<
# /___/_//_/___/\__/\_,_/_/_/  \_,_/ .__/\_,_/\_,_/\__/\__/___/
#                                 /_/
#

# Check if command exists
_checkCommandExists() {
    command -v "$1" &> /dev/null
}

# ------------------------------------------------------
# Confirm Start
# ------------------------------------------------------

sleep 1
clear
if command -v figlet &> /dev/null; then
    figlet -f smslant "Updates"
fi
echo
primarycolor=$(cat ~/.config/ml4w/colors/primary)
onsurfacecolor=$(cat ~/.config/ml4w/colors/onsurface)
onprimarycolor=$(cat ~/.config/ml4w/colors/onprimary)
if _checkCommandExists "gum"; then
    if gum confirm --selected.background=$primarycolor --selected.foreground=$onprimarycolor --prompt.foreground=$onsurfacecolor "DO YOU WANT TO START THE UPDATE NOW?"; then
        echo
        echo ":: Update started..."
    elif [ $? -eq 130 ]; then
        exit 130
    else
        echo
        echo ":: Update canceled."
        exit
    fi
else
    # Keep the updater usable when gum is missing (e.g. a fresh install
    # before the dependency list is applied).
    echo ":: gum is not installed; falling back to a plain prompt."
    read -r -p "DO YOU WANT TO START THE UPDATE NOW? [y/N] " answer
    case "$answer" in
        [yY]|[yY][eE][sS])
            echo
            echo ":: Update started..."
            ;;
        *)
            echo
            echo ":: Update canceled."
            exit
            ;;
    esac
fi

# ----------------------------------------------------- 
# Install update
# ----------------------------------------------------- 

if _checkCommandExists "dnf"; then
    sudo dnf upgrade
else
    echo ":: ERROR - Platform not supported"
    echo "Press [ENTER] to close."
    read
fi
echo

# Flatpak
if _checkCommandExists "flatpak"; then
    echo ":: Searching for Flatpak updates..."
    flatpak update
    echo
fi

# Reload Waybar
pkill -RTMIN+1 waybar

# Refresh Quickshell Statusbar
qs ipc call updates refresh
# qs ipc call updates reset

# Finishing
echo ":: Update complete! Press [ENTER] to close."
read
