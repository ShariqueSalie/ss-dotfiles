#!/usr/bin/env python3
#  _   _           _       _        ____            _
# | | | |_ __   __| | __ _| |_ ___ / ___|___  _ __ | |_ ___ _ __
# | | | | '_ \ / _` |/ _` | __/ _ \ |   / _ \| '_ \| __/ _ \ '__|
# | |_| | |_) | (_| | (_| | ||  __/ |__| (_) | | | | ||  __/ |
#  \___/| .__/ \__,_|\__,_|\__\___|\____\___/|_| |_|\__\___|_|
#       |_|
#
# Update Center backend for the ML4W Quickshell status bar.
#
#   ml4w-update-center snapshot [--force]   print the provider snapshot as JSON
#   ml4w-update-center update <provider>    run that provider's update in a terminal
#
# Besides the providers, the Update Center's Fedora maintenance buttons call
# "update dnf-distro-sync" (sudo dnf distro-sync) and "update
# dnf-upgrade-refresh" (sudo dnf upgrade --refresh).
#
# Providers (in display order):
#
#   system    package manager upgrades (dnf / dnf5 on Fedora, and the other
#             package managers ML4W supports)
#   flatpak   Flatpak app updates, checked per installed remote
#   dotfiles  commits on the GitHub branch of the dotfiles clone against the
#             local checkout -- this is what reports "a change was committed"
#
# The snapshot is cached in ~/.cache/ml4w/update-center.json for
# $ML4W_UPDATE_CENTER_TTL seconds (default ten minutes), so opening the popup
# repeatedly does not re-run a full dnf/flatpak scan. "snapshot --force"
# always rescans; the status bar uses that for its Refresh button.
#
# Output: {"checked": <epoch>, "providers": [{...}, ...]}
# Provider fields: id, name, icon, action, actionLabel, count, updateAvailable,
# status ("updates" | "current" | "offline" | "unavailable" | "error"),
# headline, detail, items [{name, from, to}].

import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "ml4w")
CACHE_FILE = os.path.join(CACHE_DIR, "update-center.json")
DEFAULT_TTL = 600
DOTFILES_DIR = os.environ.get("ML4W_DOTFILES_DIR", "")


def ttl():
    try:
        return max(0, int(os.environ.get("ML4W_UPDATE_CENTER_TTL", DEFAULT_TTL)))
    except ValueError:
        return DEFAULT_TTL


def run(command, timeout, cwd=None):
    env = dict(os.environ, LC_ALL="C", LANG="C")
    try:
        result = subprocess.run(command, capture_output=True, text=True,
                                timeout=timeout, cwd=cwd, env=env)
        return result.returncode, result.stdout, result.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "The check timed out"
    except FileNotFoundError:
        return 127, "", "%s is not installed" % command[0]
    except OSError as error:
        return 1, "", str(error)


def provider(identifier, name, icon, action, headline, count=0, status="current",
             detail="", items=None, action_label="Update"):
    return {
        "id": identifier,
        "name": name,
        "icon": icon,
        "action": action,
        "actionLabel": action_label,
        "count": count,
        "updateAvailable": count > 0,
        "status": status,
        "headline": headline,
        "detail": detail,
        "items": items or [],
    }


def plural(count, singular, plural_form=None):
    return "%d %s" % (count, singular if count == 1 else (plural_form or singular + "s"))


# ---------------------------------------------------------------- system ----

def scan_system():
    identifier, name, icon = "system", "Fedora packages", "fedora.svg"
    managers = [
        ("pacman", "Arch Linux packages"),
        ("dnf", "Fedora packages"),
        ("zypper", "openSUSE packages"),
        ("apt", "Debian packages"),
    ]
    manager = next(((cmd, label) for cmd, label in managers if shutil.which(cmd)), None)
    if manager is None:
        return provider(identifier, "System packages", icon, "system",
                        "No supported package manager found", status="unavailable")

    command, label = manager
    items = []

    if command == "pacman":
        code, out, err = run(["pacman", "-Qu"], 180)
        if code != 0:
            return provider(identifier, label, icon, "system", "Could not check for updates",
                            status="error", detail=(err or out).strip()[:400])
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 4:
                items.append({"name": parts[0], "from": parts[1], "to": parts[3]})

    elif command == "dnf":
        code, out, err = run([shutil.which("dnf"), "-q", "check-update"], 240)
        if code not in (0, 100):
            message = (err or out).strip().splitlines()
            return provider(identifier, label, icon, "system", "Could not check for updates",
                            status="error", detail=message[0][:400] if message else "")
        for line in out.splitlines():
            line = line.rstrip()
            if not line or line[0].isspace() or line.startswith(("Last metadata", "Name")):
                continue
            parts = line.split()
            # dnf4: "name.arch  version  repo"; dnf5 table: "name arch version repo ..."
            if len(parts) >= 4 and re.match(r"^(x86_64|i[3-6]86|aarch64|armv7hl|noarch|ppc64le|s390x)$", parts[1]):
                items.append({"name": parts[0], "from": "", "to": parts[2]})
            elif len(parts) >= 3 and "." in parts[0]:
                items.append({"name": parts[0].rsplit(".", 1)[0], "from": "", "to": parts[1]})

    elif command == "zypper":
        code, out, err = run(["zypper", "--non-interactive", "--quiet", "list-updates"], 180)
        if code != 0:
            return provider(identifier, label, icon, "system", "Could not check for updates",
                            status="error", detail=(err or out).strip()[:400])
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 5 and parts[0] == "v":
                items.append({"name": parts[2], "from": parts[3], "to": parts[4]})

    else:
        code, out, err = run(["apt", "list", "--upgradable"], 180)
        if code != 0:
            return provider(identifier, label, icon, "system", "Could not check for updates",
                            status="error", detail=(err or out).strip()[:400])
        for line in out.splitlines():
            if "/" not in line or line.startswith("Listing"):
                continue
            name = line.split("/", 1)[0]
            new = ""
            match = re.search(r"\s(\S+)\s+\S+\s+\[upgradable from:", line)
            if match:
                new = match.group(1)
            items.append({"name": name, "from": "", "to": new})

    seen = set()
    unique = []
    for item in items:
        if item["name"] in seen:
            continue
        seen.add(item["name"])
        unique.append(item)

    count = len(unique)
    if count == 0:
        return provider(identifier, label, icon, "system", "Up to date")
    return provider(identifier, label, icon, "system",
                    plural(count, "package") + " available", count=count,
                    status="updates", items=unique[:200])


# --------------------------------------------------------------- flatpak ----

def flatpak_origins():
    code, out, err = run(["flatpak", "list", "--app", "--columns=application,origin,installation"], 60)
    if code != 0:
        return []
    origins = []
    for line in out.splitlines():
        fields = line.split("\t")
        if len(fields) != 3:
            continue
        installation, origin = fields[2].strip(), fields[1].strip()
        if origin and (origin, installation) not in origins:
            origins.append((origin, installation))
    return origins


def scan_flatpak():
    identifier, name, icon = "flatpak", "Flatpak", "flatpak.svg"
    if not shutil.which("flatpak"):
        return provider(identifier, name, icon, "flatpak", "Flatpak is not installed",
                        status="unavailable")

    origins = flatpak_origins()
    if not origins:
        return provider(identifier, name, icon, "flatpak", "No Flatpak apps installed")

    items = []
    failures = []
    for origin, installation in origins:
        code, out, err = run(["flatpak", "remote-ls", "--" + installation, "--updates",
                              "--columns=application,branch", origin], 90)
        if code != 0:
            failures.append((err or out).strip().splitlines()[0] if (err or out).strip() else origin)
            continue
        for line in out.splitlines():
            fields = line.split("\t")
            if not fields or not fields[0].strip():
                continue
            items.append({"name": fields[0].strip(),
                          "from": "",
                          "to": fields[1].strip() if len(fields) > 1 else ""})

    if failures and not items:
        return provider(identifier, name, icon, "flatpak", "Could not check Flatpak updates",
                        status="error", detail=failures[0][:400])

    count = len(items)
    detail = "; ".join(failures)[:400] if failures else ""
    if count == 0:
        return provider(identifier, name, icon, "flatpak", "Up to date", detail=detail)
    return provider(identifier, name, icon, "flatpak",
                    plural(count, "app") + " available", count=count,
                    status="updates", items=items[:200], detail=detail)


# -------------------------------------------------------------- dotfiles ----

def find_repo():
    candidates = [DOTFILES_DIR] if DOTFILES_DIR else []
    candidates += [
        os.path.join(HOME, "Documents", "dotfiles"),
        os.path.join(HOME, "dotfiles"),
        os.path.join(HOME, ".local", "share", "ml4w-dotfiles"),
    ]
    for candidate in candidates:
        if not candidate or not os.path.isdir(candidate):
            continue
        code, out, _ = run(["git", "-C", candidate, "rev-parse", "--git-dir"], 15)
        if code == 0:
            return os.path.realpath(candidate)
    return None


def git(repo, *arguments, timeout=30):
    return run(["git", "-C", repo, *arguments], timeout)


def scan_dotfiles():
    identifier, name, icon = "dotfiles", "Dotfiles (GitHub)", "git.svg"
    repo = find_repo()
    if repo is None:
        return provider(identifier, name, icon, "git",
                        "No dotfiles clone found", status="unavailable",
                        detail="Set ML4W_DOTFILES_DIR to your dotfiles checkout.",
                        action_label="Pull")

    upstream = "origin/main"
    code, out, _ = git(repo, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
    if code == 0 and out.strip():
        upstream = out.strip()
    elif git(repo, "rev-parse", "--verify", "--quiet", "origin/main")[0] != 0:
        return provider(identifier, name, icon, "git",
                        "The dotfiles clone has no origin/main branch", status="unavailable",
                        action_label="Pull")

    fetch_code, _, fetch_err = git(repo, "fetch", "--quiet", "--prune", "origin", timeout=45)
    dirty_code, dirty_out, _ = git(repo, "status", "--porcelain", "--untracked-files=no")
    dirty = dirty_code == 0 and bool(dirty_out.strip())

    if fetch_code != 0:
        message = fetch_err.strip().splitlines()
        return provider(identifier, name, icon, "git",
                        "Could not reach GitHub", status="offline",
                        detail=(message[0] if message else "Network unavailable")[:400],
                        action_label="Pull")

    code, out, _ = git(repo, "rev-list", "--left-right", "--count", "HEAD..." + upstream)
    ahead = behind = 0
    if code == 0 and out.strip():
        fields = out.split()
        if len(fields) == 2:
            ahead, behind = int(fields[0]), int(fields[1])

    code, out, _ = git(repo, "log", "-1", "--format=%h%x09%s", upstream)
    latest = out.strip() if code == 0 and out.strip() else ""
    latest_sha, _, latest_subject = latest.partition("\t")

    items = []
    if behind > 0:
        code, out, _ = git(repo, "log", "--format=%h%x09%s",
                           "--max-count=20", "HEAD.." + upstream)
        if code == 0:
            for line in out.splitlines():
                sha, _, subject = line.partition("\t")
                if sha:
                    items.append({"name": sha + "  " + subject, "from": "", "to": ""})

    detail_parts = []
    if latest_subject:
        detail_parts.append("Latest on GitHub: " + latest_sha + " " + latest_subject)
    if dirty:
        detail_parts.append("The local checkout has uncommitted changes")
    if ahead:
        detail_parts.append(plural(ahead, "local commit") + " not pushed")

    if behind > 0:
        headline = plural(behind, "commit") + " behind GitHub"
        status = "updates"
    elif ahead > 0:
        headline = "Up to date (local commits not pushed)"
        status = "current"
    else:
        headline = "Up to date with GitHub"
        status = "current"

    return provider(identifier, name, icon, "git", headline, count=behind, status=status,
                    detail=" · ".join(detail_parts), items=items, action_label="Pull")


# --------------------------------------------------------------- actions ----

def terminal():
    configured = os.path.join(HOME, ".config", "ml4w", "settings", "terminal.sh")
    try:
        with open(configured, "r", encoding="utf-8") as handle:
            command = shlex.split(handle.read().strip())
    except OSError:
        command = []
    if not command:
        for candidate in ("kitty", "ghostty", "alacritty", "foot", "xdg-terminal-exec"):
            if shutil.which(candidate):
                command = [candidate]
                break
    return command


def run_in_terminal(shell_command):
    command = terminal()
    if not command:
        return False
    program = os.path.basename(command[0])
    if program == "kitty":
        command += ["--class", "dotfiles-floating"]
    if program == "foot":
        command += ["--app-id", "dotfiles-floating"]
    command += ["-e", "bash", "-lc", shell_command]
    subprocess.Popen(command, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True


def launch_update(identifier):
    if identifier == "system":
        # Run in a terminal: the updater uses gum for the confirmation prompt
        # and sudo needs a TTY to ask for the password. A detached, output-less
        # Popen left the user staring at an Update button that did nothing.
        script = os.path.join(HOME, ".config", "ml4w", "scripts", "ml4w-install-system-updates")
        return run_in_terminal(
            "bash " + shlex.quote(script) + ";"
            " echo; read -n 1 -s -r -p 'Press any key to close...'")

    if identifier == "flatpak":
        return run_in_terminal(
            "flatpak update; qs ipc call updates refresh >/dev/null 2>&1;"
            " echo; read -n 1 -s -r -p 'Press any key to close...'")

    if identifier == "dotfiles":
        repo = find_repo()
        if repo is None:
            return False
        return run_in_terminal(
            "cd " + shlex.quote(repo) + " && git pull --ff-only;"
            " qs ipc call updates refresh >/dev/null 2>&1;"
            " echo; read -n 1 -s -r -p 'Press any key to close...'")

    # Fedora maintenance buttons shown below the provider rows. dnf prompts
    # for its own confirmation (no -y) and needs a TTY for sudo.
    if identifier == "dnf-distro-sync":
        if not shutil.which("dnf"):
            return False
        return run_in_terminal(
            "sudo dnf distro-sync;"
            " qs ipc call updates refresh >/dev/null 2>&1;"
            " echo; read -n 1 -s -r -p 'Press any key to close...'")

    if identifier == "dnf-upgrade-refresh":
        if not shutil.which("dnf"):
            return False
        return run_in_terminal(
            "sudo dnf upgrade --refresh;"
            " qs ipc call updates refresh >/dev/null 2>&1;"
            " echo; read -n 1 -s -r -p 'Press any key to close...'")

    return False


# ------------------------------------------------------------------ main ----

def snapshot(force):
    if not force:
        try:
            if os.path.getmtime(CACHE_FILE) + ttl() > time.time():
                with open(CACHE_FILE, "r", encoding="utf-8") as handle:
                    return json.load(handle)
        except (OSError, ValueError):
            pass

    providers = [scan_system(), scan_flatpak(), scan_dotfiles()]
    data = {"checked": int(time.time()), "providers": providers}
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        temporary = CACHE_FILE + ".tmp"
        with open(temporary, "w", encoding="utf-8") as handle:
            json.dump(data, handle)
        os.replace(temporary, CACHE_FILE)
    except OSError:
        pass
    return data


def main():
    arguments = sys.argv[1:]
    action = arguments[0] if arguments else "snapshot"
    if action in ("snapshot", "refresh", "check"):
        force = "--force" in arguments or action in ("refresh", "check")
        json.dump(snapshot(force), sys.stdout)
        sys.stdout.write("\n")
        return 0
    if action in ("update", "upgrade") and len(arguments) > 1:
        return 0 if launch_update(arguments[1]) else 1
    sys.stderr.write("usage: ml4w-update-center snapshot [--force] | update <provider>\n")
    return 2


if __name__ == "__main__":
    sys.exit(main())
